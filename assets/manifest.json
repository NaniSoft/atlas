{
  "$comment": [
    "Site-owned content assets, governed by the central asset design contract.",
    "Variants and budgets are copied from the published design-system manifest",
    "(@nanisoft/prism-ui/dist/assets/manifest.json); the only site additions are the",
    "share card and the route favicon, recorded with their DS-missing-capability",
    "note in `exception`. Every entry is validated by `npm run ui:check`.",
    "Centrally owned assets (marks, fonts, glyphs) are consumed from the package",
    "and are never duplicated here."
  ],
  "version": 1,
  "variants": {
    "hero": { "aspectRatio": "16 / 9", "objectFit": "cover", "maxRendered": { "widthPx": 1152, "heightPx": 420 } },
    "wide-hero": { "aspectRatio": "21 / 9", "objectFit": "cover", "maxRendered": { "widthPx": 1152, "heightPx": 493 } },
    "banner": { "aspectRatio": "3 / 1", "objectFit": "cover", "maxRendered": { "widthPx": 1152, "heightPx": 160 } },
    "card": { "aspectRatio": "4 / 3", "objectFit": "cover", "maxRendered": { "widthPx": 800, "heightPx": 600 } },
    "landscape-thumb": { "aspectRatio": "16 / 9", "objectFit": "cover", "maxRendered": { "widthPx": 400, "heightPx": 225 } },
    "square-thumb": { "aspectRatio": "1 / 1", "objectFit": "cover", "maxRendered": { "widthPx": 400, "heightPx": 400 } },
    "avatar": { "aspectRatio": "1 / 1", "objectFit": "cover", "maxRendered": { "widthPx": 64, "heightPx": 64 } },
    "product": { "aspectRatio": "1 / 1", "objectFit": "contain", "maxRendered": { "widthPx": 800, "heightPx": 800 } },
    "logo": { "aspectRatio": null, "objectFit": "contain", "maxRendered": { "widthPx": 320, "heightPx": 128 } },
    "illustration": { "aspectRatio": null, "objectFit": "contain", "maxRendered": { "widthPx": 800, "heightPx": 800 } },
    "icon": { "aspectRatio": "1 / 1", "objectFit": "contain", "maxRendered": { "widthPx": 48, "heightPx": 48 } },
    "og": { "aspectRatio": "1200 / 630", "objectFit": "cover", "maxRendered": { "widthPx": 1200, "heightPx": 630 } }
  },
  "budgetsKiB": { "icon": 10, "illustration": 50, "logo": 50, "card": 200, "banner": 300, "hero": 500, "thumbnail": 100, "font": 150, "og": 100 },
  "assets": [
    {
      "id": "favicon-icon",
      "file": "app/icon.svg",
      "category": "logo",
      "format": "svg",
      "allowedVariants": ["logo"],
      "budgetKiB": 50,
      "role": "brand-logo",
      "license": "NaniSoft proprietary",
      "exception": "Favicon is a fixed-color brand mark; chrome supplies its own ground, so currentColor would fail outside the token cascade. Same exemption DS grants prism-icon-svg."
    },
    {
      "id": "share-card",
      "file": "public/opengraph-image.png",
      "category": "og",
      "format": "png",
      "intrinsicWidth": 1200,
      "intrinsicHeight": 630,
      "aspectRatio": "1200 / 630",
      "allowedVariants": ["og"],
      "maxRenderedWidthPx": 1200,
      "maxRenderedHeightPx": 630,
      "devicePixelRatio": 1,
      "minSource": { "widthPx": 1200, "heightPx": 630 },
      "budgetKiB": 100,
      "role": "share-card",
      "license": "NaniSoft proprietary",
      "exception": "DS ships no OG surface (governance #4). A committed static bitmap replaces the next/og generator so no inline styles exist."
    }
  ]
}
