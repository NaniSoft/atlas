{
  "name": "@nanisoft/atlas",
  "version": "0.0.0",
  "private": true,
  "description": "atlas.nanisoft.com — Atlas, the Digital Twin Platform: living representations of systems, assets, and operations. Landing, full docs, and blog.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:antd": "node scripts/check-antd.mjs",
    "check:stylesheet": "node scripts/check-stylesheet-ownership.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:pack-map": "node scripts/check-pack-map.mjs",
    "check:docs-tree": "vitest run test/docs-tree.test.tsx",
    "check": "pnpm check:antd && pnpm check:stylesheet && pnpm check:docs-tree && pnpm check:links && pnpm check:pack-map"
  },
  "dependencies": {
    "@nanisoft/prism-tokens": "0.6.0",
    "@nanisoft/prism-ui": "0.7.0",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.135.0"
  }
}
