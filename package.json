{
  "name": "@nanisoft/atlas",
  "version": "0.0.0",
  "private": true,
  "description": "atlas.nanisoft.com — Atlas, the Digital Twin Platform: living representations of systems, assets, and operations. Landing, full docs, and blog.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "ui:check": "node scripts/ui-check.mjs",
    "visual": "playwright test",
    "check:docs-tree": "vitest run test/docs-tree.test.tsx",
    "check:prism-gates": "prism-gates",
    "check": "pnpm ui:check && pnpm check:prism-gates && pnpm check:docs-tree"
  },
  "dependencies": {
    "@nanisoft/prism-ui": "1.9.0",
    "fumadocs-core": "^16.18.1",
    "fumadocs-mdx": "^15.5.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.92.0",
    "serve": "^14.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
